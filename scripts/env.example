# GoSoCode production environment example.
# Copy to /etc/gosocode/env and adjust for your deployment.

GSC_ENV=production
GSC_ADDR=:8080
GSC_DB=/var/lib/gosocode/gosocode.db
GSC_JWT_SECRET=CHANGE-ME-TO-A-RANDOM-HEX-STRING
# Optional. Only used when the database is first created.
# GSC_ADMIN_PASSWORD=
GSC_REDIS=
GSC_APP_NAME=gosocode
GSC_BAIDU_APPKEY=
GSC_BAIDU_SECRET=
GSC_REDIRECT_URI=https://gosocode.example.com/api/oauth/callback
GSC_KEYS_DIR=/var/lib/gosocode/gsc-keys
GSC_CLIENT_DIR=/var/lib/gosocode/client-bin
GSC_AGENT_ENABLED=1
GSC_AGENT_CONTROL_KEY=CHANGE-ME-TO-ANOTHER-RANDOM-HEX-STRING
GSC_STREAM_ENABLED=1
GSC_STREAM_MAX_CONCURRENT=8
GSC_STREAM_WINDOW=3
GSC_DAILY_RECONCILE=1
GSC_TIMEZONE=Asia/Shanghai
